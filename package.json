{
	"name": "optigrid",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.0.0",
	"scripts": {
		"dev": "pnpm --parallel --filter ./frontend --filter ./backend/core run dev",
		"build": "pnpm -r run build",
		"test": "pnpm -r run test", 
		"test:e2e": "playwright test",
		"storybook": "pnpm --filter ./frontend run storybook",
		"storybook:build": "pnpm --filter ./frontend run build-storybook",
		"security:test": "snyk test --all-projects",
		"security:monitor": "snyk monitor --all-projects",
		"prepare": "playwright install --with-deps"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"jest": "^29.7.0",
		"snyk": "^1.1304.0",
		"testcontainers": "^10.21.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"msgpackr-extract",
			"prisma",
			"protobufjs",
			"sharp",
			"snyk",
			"ssh2"
		]
	}



}
