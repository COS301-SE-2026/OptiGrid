# OptiGrid production environment variables
# Copy this file to .env and fill in managed service values before deployment.

NODE_ENV=production

# Container port mappings
FRONTEND_PORT=3000
CORE_PORT=4000
INGESTION_PORT=8000
ANALYTICS_PORT=8001

# Supabase (external managed service)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# InfluxDB (external managed service)
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=
