// Canonical diagram source. Render commands and evidence are in deployment.md.
// Scope: configured production target at repository commit 26037c1, not a live audit.
digraph OptiGridDeployment {
  graph [
    rankdir=TB, compound=true, newrank=true, splines=spline,
    nodesep=0.42, ranksep=0.82, pad=0.3,
    bgcolor="#ffffff", fontname="Arial", fontsize=22,
    labelloc=t, labeljust=l,
    label="OptiGrid | Deployment diagram\nConfigured production target / repository evidence, 03 Sep 2026\nCoreflow | Source: production Compose + Terraform | Revision: 26037c1"
  ];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#7799bb",
        fontname="Arial", fontsize=12, fontcolor="#14283d", margin="0.20,0.14", penwidth=1.2];
  edge [fontname="Arial", fontsize=10, fontcolor="#254f73", color="#567c9f",
        arrowsize=0.7, penwidth=1.15];

  browser [label="<<device>>\nUser browser\nManager / admin / viewer", fillcolor="#f1f5f9", color="#94a3b8"];

  subgraph cluster_frontend {
    label="FRONTEND HOSTING: UNRESOLVED\nProduction location and instance count not declared";
    style="rounded,dashed"; color="#c28433"; fontcolor="#835413"; fontsize=13;
    frontend [label="<<execution environment>>\nFrontend 0.1.0\nNext.js 15 / React 19\nNode.js 20 Docker image; HTTP :3000\nAbsent from production Compose", fillcolor="#fff8e9", color="#c28433", style="rounded,filled,dashed"];
  }

  subgraph cluster_aws {
    label="TRUST BOUNDARY: PUBLIC INTERNET / AWS ESTATE\nAWS production target | region default: us-east-1 | default VPC";
    style="rounded"; color="#5577a0"; fontcolor="#23496e"; fontsize=15; penwidth=1.7;

    subgraph cluster_ec2 {
      label="<<infrastructure node>> EC2 x1 | Ubuntu 24.04 | Docker Engine + Compose\nFAILURE DOMAIN: one host, one subnet; availability-zone name not declared\nOne shared Docker network; no enforced app / data tier boundary";
      style="rounded,filled"; fillcolor="#f7faff"; color="#94acc7"; fontcolor="#334d68"; fontsize=13;

      core [label="<<container>> core x1\nCore API 0.1.0\nNode.js 20 / Express 4\nHTTP :4000 / SSE / WebSocket\nAuth + RBAC + rate limiting\nAudit and escalation workers in process"];
      ingestion_api [label="<<container>> ingestion-api x1\nIngestion API 1.0.0\nPython 3.11 / FastAPI\nHTTP :8000\nValidate and enqueue telemetry"];
      analytics [label="<<container>> analytics x1\nAnalytics API 1.0.0\nPython 3.11 / FastAPI\nHTTP :5001\nBatch scheduler not started by Compose"];
      worker [label="<<container>> ingestion x1\nTelemetry queue worker\nPython 3.11\nInflux writes + anomaly detection", fillcolor="#eefaf5", color="#76a892"];
      emulator [label="<<container>> sensor-emulator x1\nPython 3.11\nGenerates synthetic sensor readings\nNot a physical device", fillcolor="#eefaf5", color="#76a892"];
      seeder [label="<<container>> seeder\nOne-shot bootstrap job\nPython 3.11\nEmulator waits for completion", fillcolor="#eefaf5", color="#76a892"];

      redis [shape=cylinder, label="<<container / datastore>>\nRedis 7 x1 | RESP :6379\nQueues + streams + Pub/Sub + cache\nNo configured replica\nNo explicit volume / AOF in prod Compose", fillcolor="#fff4e7", color="#b88b58"];
      influx [shape=cylinder, label="<<container / datastore>>\nInfluxDB 2.7 x1 | HTTP :8086\nEnergy telemetry\nLocal volumes: influxdb_data / config\nNo configured replica", fillcolor="#fff4e7", color="#b88b58"];
      mlflow [label="<<container>> mlflow x1\nMLflow 2.12.1 | HTTP :5000\nSQLite + model artifacts\nLocal volume: mlflow_data", fillcolor="#fff4e7", color="#b88b58"];
    }
  }

  subgraph cluster_external {
    label="TRUST BOUNDARIES: EXTERNAL PROVIDERS\nSeparate services; provider regions / HA not declared";
    style="rounded,dashed"; color="#9a8bb5"; fontcolor="#65527f"; fontsize=13;
    supabase [label="<<managed service>> Supabase\nAuth + REST API | HTTPS :443\nPostgreSQL via DATABASE_URL\nSQL port / TLS mode / DB version unknown\nUsers, buildings, alerts and analytics", fillcolor="#f5f1fc", color="#9a8bb5"];
    resend [label="<<external service>> Resend\nContact email API\nHTTPS :443 / API key", fillcolor="#f5f1fc", color="#9a8bb5"];
  }

  browser -> frontend [label="UI / REST requests; SSE back\nPublic port + TLS not configured", style=dashed, color="#b77925", fontcolor="#835413"];
  frontend -> core [label="REST + SSE via CORE_URL\nCore listens on HTTP :4000\nProduction ingress unresolved", style=dashed, color="#b77925", fontcolor="#835413"];

  core -> ingestion_api [label="HTTP :8000 / sync\nProvision building"];
  core -> analytics [label="HTTP :5001 / sync\nProvision analytics"];
  emulator -> ingestion_api [label="HTTP :8000 / sync POST\n/api/telemetry/ingest"];
  ingestion_api -> redis [label="RESP :6379 / LPUSH\ningestion_queue / async work", style=dashed, color="#b56b24", fontcolor="#95551d"];
  redis -> worker [label="RESP :6379 / BRPOP\nDestructive dequeue; no ACK/replay", style=dashed, color="#b56b24", fontcolor="#95551d"];
  worker -> influx [label="HTTP :8086 / token\nSynchronous writes"];
  worker -> redis [label="RESP :6379 / async\nAnomaly Pub/Sub + audit stream", style=dashed, color="#b56b24", fontcolor="#95551d", constraint=false];
  core -> redis [label="RESP :6379\nCache + thresholds; jobs / events", style=dashed, color="#b56b24", fontcolor="#95551d"];
  core -> influx [label="HTTP :8086 / token\nQueries + alternate ingestion"];
  analytics -> influx [label="HTTP :8086 / token\nQueries + bootstrap writes"];
  analytics -> mlflow [label="HTTP :5000\nModel tracking"];
  seeder -> influx [label="HTTP :8086 / token\nSeed telemetry"];

  core -> supabase [label="SQL / Prisma: DATABASE_URL\nHTTPS :443: Auth / SDK"];
  analytics -> supabase [label="HTTPS :443 / service key\nMetadata + analytics results"];
  core -> resend [label="HTTPS :443 / API key\nContact email request"];

  // Supporting links are documented below the figure instead of crossing all lanes:
  // browser + frontend -> Supabase Auth (Google OAuth redirects through the browser);
  // seeder + sensor-emulator -> Supabase REST; sensor-emulator -> InfluxDB last timestamp.
}
