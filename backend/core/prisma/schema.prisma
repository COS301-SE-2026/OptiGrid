generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN            @map("Admin")
  BUILDING_MANAGER @map("Building_Manager")
  VIEWER           @map("Viewer")

  @@map("user_role")
}

enum ThemePreference {
  LIGHT  @map("light")
  DARK   @map("dark")
  SYSTEM @map("system")

  @@map("theme_preference")
}

enum BuildingType {
  Residential
  Commercial
  Industrial
  Healthcare
  Construction
  Mixed_Use
  ShoppingCentre
  Other
}

enum SensorStatus {
  Active
  Offline
  Maintenance
}

enum LifecycleState {
  PROVISIONING        @map("provisioning")
  ACTIVE              @map("active")
  PROVISIONING_FAILED @map("provisioning_failed")
  INACTIVE            @map("inactive")

  @@map("lifecycle_state")
}

model User {
  userId         String          @id @map("user_id") @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  email          String          @unique @db.VarChar(255)
  roleType       UserRole        @default(VIEWER) @map("role_type")
  firstName      String?         @map("first_name") @db.VarChar(100)
  lastName       String?         @map("last_name") @db.VarChar(100)
  preferredTheme ThemePreference @default(SYSTEM) @map("preferred_theme")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?       @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relations
  tenant         Tenant?              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  buildingAccess UserBuildingAccess[]

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  tenantId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_id") @db.Uuid
  companyName      String    @map("company_name") @db.VarChar(255)
  subscriptionTier String?   @default("Standard") @map("subscription_tier") @db.VarChar(50)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  users     User[]
  buildings Building[]

  @@map("tenants")
}

model Building {
  building_id           String         @id @default(dbgenerated("gen_random_uuid()")) @map("building_id") @db.Uuid
  tenant_id             String?        @map("tenant_id") @db.Uuid
  building_name         String         @map("building_name") @db.VarChar(255)
  building_type         BuildingType?  @default(Residential) @map("building_type")
  square_footage        Decimal?       @map("square_footage") @db.Decimal
  physical_address      String?        @map("physical_address")
  timezone              String?        @default("UTC") @db.VarChar(50)
  max_occupancy         Int?           @map("max_occupancy")
  nominal_voltage       Float?         @default(230) @map("nominal_voltage")
  max_current_threshold Float?         @default(60) @map("max_current_threshold")
  hardware_auth_token   String?        @map("hardware_auth_token") @db.VarChar(512)
  lifecycle_state       LifecycleState @default(PROVISIONING) @map("lifecycle_state")
  created_at            DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?      @default(now()) @map("updated_at") @db.Timestamptz
  latitude              Float?
  longitude             Float?
  geohash               String?        @db.VarChar(10)

  // Relations
  tenant            Tenant?                   @relation(fields: [tenant_id], references: [tenantId], onDelete: Cascade)
  authorized_users  UserBuildingAccess[]
  sensors           Sensor[]
  weekly_analytics  BuildingAnalyticsWeekly?
  monthly_analytics BuildingAnalyticsMonthly?

  @@index([tenant_id])
  @@map("buildings")
}

model UserBuildingAccess {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @map("user_id") @db.Uuid
  building_id String   @map("building_id") @db.Uuid

  // Relations
  user     User     @relation(fields: [user_id], references: [userId], onDelete: Cascade)
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@unique([user_id, building_id])
  @@map("user_building_access")
}

model Sensor {
  sensor_id      String        @id @default(dbgenerated("gen_random_uuid()")) @map("sensor_id") @db.Uuid
  building_id    String?       @map("building_id") @db.Uuid
  mac_address    String        @unique @map("mac_address") @db.VarChar(50)
  sensor_type    String?       @map("sensor_type") @db.VarChar(100)
  unit           String?       @default("kWh") @db.VarChar(50)
  location_zone  String?       @map("location_zone") @db.VarChar(100)
  status         SensorStatus? @default(Active)
  installed_date DateTime?     @default(now()) @map("installed_date") @db.Date
  created_at     DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updated_at     DateTime?     @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  building Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@index([building_id])
  @@map("sensors")
}

model BuildingAnalyticsWeekly {
  building_id      String    @id @map("building_id") @db.Uuid
  todays_usage     Decimal?  @default(0.0) @map("todays_usage") @db.Decimal
  todays_cost      Decimal?  @default(0.0) @map("todays_cost") @db.Decimal
  forecast_peak    Decimal?  @default(0.0) @map("forecast_peak") @db.Decimal
  forecast_avg_day Decimal?  @default(0.0) @map("forecast_avg_day") @db.Decimal
  model_mape       Decimal?  @default(0.0) @map("model_mape") @db.Decimal
  forecast_series  Json?     @map("forecast_series")
  updated_at       DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  min_historic     Decimal?  @default(0.0) @map("min_historic") @db.Decimal
  max_historic     Decimal?  @default(0.0) @map("max_historic") @db.Decimal
  min_forecast     Decimal?  @default(0.0) @map("min_forecast") @db.Decimal
  max_forecast     Decimal?  @default(0.0) @map("max_forecast") @db.Decimal

  // Relations
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("building_analytics_weekly")
}

model BuildingAnalyticsMonthly {
  building_id      String    @id @map("building_id") @db.Uuid
  todays_usage     Decimal?  @default(0.0) @map("todays_usage") @db.Decimal
  todays_cost      Decimal?  @default(0.0) @map("todays_cost") @db.Decimal
  forecast_peak    Decimal?  @default(0.0) @map("forecast_peak") @db.Decimal
  forecast_avg_day Decimal?  @default(0.0) @map("forecast_avg_day") @db.Decimal
  model_mape       Decimal?  @default(0.0) @map("model_mape") @db.Decimal
  forecast_series  Json?     @map("forecast_series")
  updated_at       DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  min_historic     Decimal?  @default(0.0) @map("min_historic") @db.Decimal
  max_historic     Decimal?  @default(0.0) @map("max_historic") @db.Decimal
  min_forecast     Decimal?  @default(0.0) @map("min_forecast") @db.Decimal
  max_forecast     Decimal?  @default(0.0) @map("max_forecast") @db.Decimal

  // Relations
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("building_analytics_monthly")
}