generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ==========================================
// ENUMS
// ==========================================

enum TelemetrySource {
  PHYSICAL
  EMULATOR

  @@schema("public")
}

enum UserRole {
  ADMIN            @map("Admin")
  BUILDING_MANAGER @map("Building_Manager")
  VIEWER           @map("Viewer")

  @@map("user_role")
  @@schema("public")
}

enum ThemePreference {
  LIGHT  @map("light")
  DARK   @map("dark")
  SYSTEM @map("system")

  @@map("theme_preference")
  @@schema("public")
}

// A user can deactivate their account without losing the profile and access
// records needed to restore it later.
enum AccountStatus {
  ACTIVE      @map("active")
  DEACTIVATED @map("deactivated")

  @@map("account_status")
  @@schema("public")
}

enum BuildingType {
  Residential
  Commercial
  Industrial
  Healthcare
  Construction
  Mixed_Use
  ShoppingCentre
  Other

  @@schema("public")
}

enum SensorStatus {
  Active
  Offline
  Maintenance

  @@map("sensor_status")
  @@schema("public")
}

enum LifecycleState {
  PROVISIONING        @map("provisioning")
  ACTIVE              @map("active")
  PROVISIONING_FAILED @map("provisioning_failed")
  INACTIVE            @map("inactive")

  @@map("lifecycle_state")
  @@schema("public")
}

enum AnomalyStatus {
  Open
  Resolved
  In_Progress
  Ignored

  @@map("anomaly_status")
  @@schema("public")
}

enum RecommendationStatus {
  Pending
  Implemented
  Dismissed

  @@map("recommendation_status")
  @@schema("public")
}

enum NotificationChannel {
  Email
  SMS
  InApp
  Push

  @@map("notification_channel")
  @@schema("public")
}

enum AuditSeverity {
  INFO     @map("info")
  WARNING  @map("warning")
  ERROR    @map("error")
  CRITICAL @map("critical")

  @@map("audit_severity")
  @@schema("public")
}

// ==========================================
// MODELS
// ==========================================

model User {
  userId         String          @id @map("user_id") @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  email          String          @unique @db.VarChar
  roleType       UserRole        @default(VIEWER) @map("role_type")
  firstName      String?         @map("first_name") @db.VarChar
  lastName       String?         @map("last_name") @db.VarChar
  preferredTheme ThemePreference @default(SYSTEM) @map("preferred_theme")
  accountStatus  AccountStatus   @default(ACTIVE) @map("account_status")
  deactivatedAt  DateTime?       @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?       @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  tenant            Tenant?              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  buildingAccess    UserBuildingAccess[]
  resolvedAnomalies Anomaly[]            @relation("ResolvedByUser")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([tenantId])
  @@map("users")
  @@schema("public")
}

model Tenant {
  tenantId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_id") @db.Uuid
  companyName      String    @map("company_name") @db.VarChar
  subscriptionTier String?   @default("Standard") @map("subscription_tier") @db.VarChar
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  users     User[]
  buildings Building[]

  @@map("tenants")
  @@schema("public")
}

model Building {
  building_id           String          @id @default(dbgenerated("gen_random_uuid()")) @map("building_id") @db.Uuid
  tenant_id             String?         @map("tenant_id") @db.Uuid
  building_name         String          @map("building_name") @db.VarChar
  square_footage        Decimal?        @map("square_footage") @db.Decimal
  physical_address      String?         @map("physical_address")
  timezone              String?         @default("UTC") @db.VarChar
  max_occupancy         Int?            @map("max_occupancy")
  created_at            DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?       @default(now()) @map("updated_at") @db.Timestamptz
  building_type         BuildingType?   @default(Residential) @map("building_type")
  latitude              Float?
  longitude             Float?
  geohash               String?         @db.VarChar
  nominal_voltage       Float?          @default(230) @map("nominal_voltage")
  max_current_threshold Float?          @default(60) @map("max_current_threshold")
  hardware_auth_token   String?         @map("hardware_auth_token") @db.VarChar
  lifecycle_state       LifecycleState  @default(PROVISIONING) @map("lifecycle_state")
  telemetry_source      TelemetrySource @default(EMULATOR)

  // Relations
  tenant              Tenant?                      @relation(fields: [tenant_id], references: [tenantId], onDelete: Cascade)
  authorized_users    UserBuildingAccess[]
  sensors             Sensor[]
  weekly_analytics    BuildingAnalyticsWeekly?
  monthly_analytics   BuildingAnalyticsMonthly?
  alert_thresholds    AlertThreshold[]
  anomalies           Anomaly[]
  maintenance_windows MaintenanceWindow[]
  recommendations     OptimisationRecommendation[]
  utility_tariffs     UtilityTariff[]
  audit_logs          AuditLog[]

  @@index([tenant_id])
  @@map("buildings")
  @@schema("public")
}

model UserBuildingAccess {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String @map("user_id") @db.Uuid
  building_id String @map("building_id") @db.Uuid

  // Relations
  user     User     @relation(fields: [user_id], references: [userId], onDelete: Cascade)
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@unique([user_id, building_id])
  @@map("user_building_access")
  @@schema("public")
}

model Sensor {
  sensor_id      String        @id @default(dbgenerated("gen_random_uuid()")) @map("sensor_id") @db.Uuid
  building_id    String?       @map("building_id") @db.Uuid
  mac_address    String        @unique @map("mac_address") @db.VarChar
  sensor_type    String?       @map("sensor_type") @db.VarChar
  unit           String?       @default("kWh") @db.VarChar
  location_zone  String?       @map("location_zone") @db.VarChar
  status         SensorStatus? @default(Active)
  installed_date DateTime?     @default(now()) @map("installed_date") @db.Date
  created_at     DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updated_at     DateTime?     @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  building  Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)
  anomalies Anomaly[]

  @@index([building_id])
  @@map("sensors")
  @@schema("public")
}

model AlertThreshold {
  threshold_id             String    @id @default(dbgenerated("gen_random_uuid()")) @map("threshold_id") @db.Uuid
  building_id              String?   @map("building_id") @db.Uuid
  metric_type              String    @map("metric_type") @db.VarChar
  unit                     String?   @db.VarChar
  upper_limit_kw           Decimal?  @map("upper_limit_kw") @db.Decimal
  lower_limit_kw           Decimal?  @map("lower_limit_kw") @db.Decimal
  allowed_spike_percentage Decimal?  @map("allowed_spike_percentage") @db.Decimal
  is_active                Boolean?  @default(true) @map("is_active")
  created_at               DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updated_at               DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  building  Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)
  anomalies Anomaly[]

  @@map("alert_thresholds")
  @@schema("public")
}

model Anomaly {
  anomaly_id          String         @id @default(dbgenerated("gen_random_uuid()")) @map("anomaly_id") @db.Uuid
  sensor_id           String?        @map("sensor_id") @db.Uuid
  building_id         String?        @map("building_id") @db.Uuid
  threshold_id        String?        @map("threshold_id") @db.Uuid
  anomaly_type        String         @map("anomaly_type") @db.VarChar
  severity_level      String         @map("severity_level") @db.VarChar
  description         String?
  status              AnomalyStatus? @default(Open)
  detected_timestamp  DateTime?      @default(now()) @map("detected_timestamp") @db.Timestamptz
  resolved_timestamp  DateTime?      @map("resolved_timestamp") @db.Timestamptz
  resolved_by_user_id String?        @map("resolved_by_user_id") @db.Uuid

  // Relations
  building         Building?       @relation(fields: [building_id], references: [building_id], onDelete: Cascade)
  sensor           Sensor?         @relation(fields: [sensor_id], references: [sensor_id], onDelete: Cascade)
  threshold        AlertThreshold? @relation(fields: [threshold_id], references: [threshold_id], onDelete: Cascade)
  resolved_by_user User?           @relation("ResolvedByUser", fields: [resolved_by_user_id], references: [userId], onDelete: SetNull)
  notifications    Notification[]

  @@map("anomalies")
  @@schema("public")
}

model AuditLog {
  log_id       String         @id @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  user_id      String?        @map("user_id") @db.Uuid
  building_id  String?        @map("building_id") @db.Uuid
  action_type  String         @map("action_type") @db.VarChar
  target_table String         @map("target_table") @db.VarChar
  service      String?        @db.VarChar(100)
  operation    String?        @db.VarChar(100)
  severity     AuditSeverity?
  error_code   String?        @map("error_code") @db.VarChar(100)
  request_id   String?        @map("request_id") @db.VarChar(128)
  old_value    Json?          @map("old_value")
  new_value    Json?          @map("new_value")
  metadata     Json?
  ip_address   String?        @map("ip_address")
  timestamp    DateTime?      @default(now()) @db.Timestamptz

  // Relations
  user     User?     @relation(fields: [user_id], references: [userId], onDelete: SetNull)
  building Building? @relation(fields: [building_id], references: [building_id], onDelete: SetNull)

  @@index([timestamp])
  @@index([user_id, timestamp])
  @@index([building_id, timestamp])
  @@index([service, timestamp])
  @@index([severity, timestamp])
  @@map("audit_logs")
  @@schema("public")
}

model MaintenanceWindow {
  window_id   String    @id @default(dbgenerated("gen_random_uuid()")) @map("window_id") @db.Uuid
  building_id String?   @map("building_id") @db.Uuid
  start_time  DateTime? @map("start_time") @db.Timestamptz
  end_time    DateTime? @map("end_time") @db.Timestamptz
  description String?

  // Relations
  building Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("maintenance_windows")
  @@schema("public")
}

model Notification {
  notification_id String               @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  anomaly_id      String?              @map("anomaly_id") @db.Uuid
  user_id         String?              @map("user_id") @db.Uuid
  channel         NotificationChannel?
  status          String?              @db.VarChar
  sent_at         DateTime?            @default(now()) @map("sent_at") @db.Timestamptz

  // Relations
  anomaly Anomaly? @relation(fields: [anomaly_id], references: [anomaly_id], onDelete: Cascade)
  user    User?    @relation(fields: [user_id], references: [userId], onDelete: Cascade)

  @@map("notifications")
  @@schema("public")
}

model OptimisationRecommendation {
  recommendation_id         String                @id @default(dbgenerated("gen_random_uuid()")) @map("recommendation_id") @db.Uuid
  building_id               String?               @map("building_id") @db.Uuid
  strategy_description      String                @map("strategy_description")
  estimated_monthly_savings Decimal?              @map("estimated_monthly_savings") @db.Decimal
  status                    RecommendationStatus? @default(Pending)
  generated_date            DateTime?             @default(now()) @map("generated_date") @db.Timestamptz
  implemented_date          DateTime?             @map("implemented_date") @db.Timestamptz

  // Relations
  building Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("optimisation_recommendations")
  @@schema("public")
}

model UtilityTariff {
  tariff_id         String    @id @default(dbgenerated("gen_random_uuid()")) @map("tariff_id") @db.Uuid
  building_id       String?   @map("building_id") @db.Uuid
  season_name       String?   @map("season_name") @db.VarChar
  day_type          String?   @map("day_type") @db.VarChar
  peak_rate_usd     Decimal   @map("peak_rate_usd") @db.Decimal
  off_peak_rate_usd Decimal   @map("off_peak_rate_usd") @db.Decimal
  peak_start_time   DateTime? @map("peak_start_time") @db.Time
  peak_end_time     DateTime? @map("peak_end_time") @db.Time
  created_at        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updated_at        DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  building Building? @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("utility_tariffs")
  @@schema("public")
}

model BuildingAnalyticsWeekly {
  building_id      String    @id @map("building_id") @db.Uuid
  todays_usage     Decimal?  @default(0.0) @map("todays_usage") @db.Decimal
  todays_cost      Decimal?  @default(0.0) @map("todays_cost") @db.Decimal
  forecast_peak    Decimal?  @default(0.0) @map("forecast_peak") @db.Decimal
  forecast_avg_day Decimal?  @default(0.0) @map("forecast_avg_day") @db.Decimal
  model_mape       Decimal?  @default(0.0) @map("model_mape") @db.Decimal
  forecast_series  Json?     @map("forecast_series")
  updated_at       DateTime? @default(now()) @map("updated_at") @db.Timestamptz
  min_historic     Decimal?  @default(0.0) @map("min_historic") @db.Decimal
  max_historic     Decimal?  @default(0.0) @map("max_historic") @db.Decimal
  min_forecast     Decimal?  @default(0.0) @map("min_forecast") @db.Decimal
  max_forecast     Decimal?  @default(0.0) @map("max_forecast") @db.Decimal

  // Relations
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("building_analytics_weekly")
  @@schema("public")
}

model BuildingAnalyticsMonthly {
  building_id      String    @id @map("building_id") @db.Uuid
  todays_usage     Decimal?  @default(0.0) @map("todays_usage") @db.Decimal
  todays_cost      Decimal?  @default(0.0) @map("todays_cost") @db.Decimal
  forecast_peak    Decimal?  @default(0.0) @map("forecast_peak") @db.Decimal
  forecast_avg_day Decimal?  @default(0.0) @map("forecast_avg_day") @db.Decimal
  model_mape       Decimal?  @default(0.0) @map("model_mape") @db.Decimal
  forecast_series  Json?     @default("0.0") @map("forecast_series")
  updated_at       DateTime? @default(now()) @map("updated_at") @db.Timestamptz
  min_historic     Decimal?  @default(0.0) @map("min_historic") @db.Decimal
  max_historic     Decimal?  @default(0.0) @map("max_historic") @db.Decimal
  min_forecast     Decimal?  @default(0.0) @map("min_forecast") @db.Decimal
  max_forecast     Decimal?  @default(0.0) @map("max_forecast") @db.Decimal

  // Relations
  building Building @relation(fields: [building_id], references: [building_id], onDelete: Cascade)

  @@map("building_analytics_monthly")
  @@schema("public")
}
