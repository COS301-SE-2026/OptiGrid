generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User table essentialy,  which is made according to the db schema
model User {
  userId             String                         @id @map("user_id") @db.Uuid
  tenantId           String?                        @map("tenant_id") @db.Uuid
  email              String                         @unique @db.VarChar(255)
  roleType           Unsupported("user_role")      @default(dbgenerated("'Viewer'::user_role")) @map("role_type")
  firstName          String?                        @map("first_name") @db.VarChar(100)
  lastName           String?                        @map("last_name") @db.VarChar(100)
  preferredTheme     Unsupported("theme_preference") @default(dbgenerated("'system'::theme_preference")) @map("preferred_theme")
  passwordHash      String                          @map("password_hash") @db.VarChar(255)
  createdAt          DateTime?                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime?                      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}