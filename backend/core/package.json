{
	"name": "@optigrid/core",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"postinstall": "prisma generate --schema=./prisma/schema.prisma",
		"dev": "tsx watch src/server.ts",
		"build": "DATABASE_URL=\"postgresql://dummy:dummy@localhost:5432/dummy\" prisma generate && tsc -p tsconfig.json",
		"start": "node dist/src/server.js",
		"test": "jest --passWithNoTests",
		"lint": "eslint .",
		"test:unit": "jest --passWithNoTests",
		"test:integration": "jest --config ./jest.integration.json --runInBand",
		"test:supabase": "jest --config ./jest.supabase.json --runInBand",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.0.0",
		"@supabase/supabase-js": "^2.49.0",
		"bcrypt": "^5.1.1",
		"bullmq": "^5.48.1",
		"dotenv": "^16.5.0",
		"express": "^4.18.2",
		"express-validator": "^7.2.1",
		"ioredis": "^5.6.1",
		"pg": "^8.14.1",
		"redis": "^4.7.0",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^4.17.20",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.19.17",
		"@types/pg": "^8.15.5",
		"@types/supertest": "^6.0.3",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"jest": "^29.7.0",
		"prisma": "^7.0.0",
		"supertest": "^7.1.4",
		"testcontainers": "^10.21.0",
		"ts-jest": "^29.4.9",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"zod": "^4.3.6"
	}
}
