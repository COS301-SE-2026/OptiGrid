{
	"name": "@optigrid/core",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"postinstall": "node ./scripts/prisma-generate-dummy.mjs --schema=./prisma/schema.prisma",
		"dev": "tsx watch src/server.ts",
		"build": "node ./scripts/prisma-generate-dummy.mjs && tsc -p tsconfig.json",
		"start": "node dist/src/server.js",
		"test": "jest --config ./jest.config.cjs",
		"lint": "eslint .",
		"test:unit": "jest",
		"test:integration": "jest --config ./jest.integration.json --runInBand",
		"test:supabase": "jest --config ./jest.supabase.json --runInBand",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"pretest": "node ./scripts/prisma-generate-dummy.mjs --schema=./prisma/schema.prisma"
	},
	"dependencies": {
		"@influxdata/influxdb-client": "^1.35.0",
		"@influxdata/influxdb-client-apis": "^1.35.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@prisma/config": "^7.10.0",
		"@supabase/supabase-js": "^2.116.0",
		"bcrypt": "^5.1.1",
		"bullmq": "^5.81.5",
		"cors": "^2.8.6",
		"dotenv": "^16.6.1",
		"express": "^4.22.3",
		"express-validator": "^7.3.2",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"node-cron": "^3.0.3",
		"pdfkit": "^0.20.2",
		"pg": "^8.23.0",
		"redis": "^4.7.1",
		"resend": "^6.28.0",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1",
		"ws": "^8.21.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@jest/get-type": "^30.5.0",
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.25",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.20.2",
		"@types/node-cron": "^3.0.11",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^6.0.3",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"jest": "^29.7.0",
		"prisma": "^7.10.0",
		"supertest": "^7.2.2",
		"testcontainers": "^10.28.0",
		"ts-jest": "^29.4.12",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3"
	}
}
