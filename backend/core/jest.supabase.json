{
	"preset": "ts-jest",
	"testEnvironment": "node",
	"roots": ["<rootDir>/../../tests/integration/backend/core"],
	"setupFiles": ["<rootDir>/../../tests/integration/backend/core/setup-env.ts"],
	"testMatch": ["**/supabase-login.integration.test.ts", "**/building.integration.test.ts"],
	"transform": {
		"^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.jest.json" }]
	},
	"clearMocks": true,
	"restoreMocks": true,
	"testTimeout": 180000
}
