{
	"testEnvironment": "node",
	"roots": ["<rootDir>/../../tests/integration/backend/core"],
	"setupFiles": ["<rootDir>/../../tests/integration/backend/core/setup-env.ts"],
	"testMatch": ["**/*.integration.test.ts"],
	"transform": {
		"^.+\\.[tj]sx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.jest.json" }]
	},
	"moduleNameMapper": {
		"^uuid$": "<rootDir>/__mocks__/uuid-mock.ts"
	},
	"clearMocks": true,
	"restoreMocks": true,
	"testTimeout": 180000
}
